views:
  - type: table
    name: Spells
    filters:
      and:
        - file.tags.contains("Spell")
    groupBy:
      property: tags
      direction: ASC
    order:
      - file.name
      - file.tags
    sort: []
  - type: table
    name: Barbarian
    filters:
      and:
        - file.tags.containsAny("MagicItem/Attunement/Barbarian")
    order:
      - file.name
      - file.tags
      - tags
  - type: table
    name: Bard
    filters:
      and:
        - file.tags.containsAny("MagicItem/Attunement/Bard", "Spell/Bard")
    groupBy:
      property: tags
      direction: ASC
    order:
      - file.name
      - file.tags
      - tags
  - type: table
    name: Cleric
